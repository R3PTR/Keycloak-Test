HTTP_PORT=8080
PUBLIC_URL=http://localhost:8080
KC_ADMIN=admin
KC_ADMIN_PASSWORD=change-me
KC_DB_PASSWORD=change-me
USERS_DB_PASSWORD=change-me
# Shared secret: Keycloak SPI -> user-service /internal API
